[sqlfluff]
dialect = bigquery
templater = raw
max_line_length = 120
# Compiled SQL is produced by dbt macro expansion; layout rules on source
# models are enforced locally via the dbt templater and .sqlfluff.
exclude_rules = structure.using, structure.column_order, layout

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit
